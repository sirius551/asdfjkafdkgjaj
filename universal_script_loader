local function CreateTab(tabName)
    local TabButton = Instance.new("TextButton")
    TabButton.Parent = Sidebar
    TabButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    TabButton.BorderSizePixel = 0
    TabButton.Size = UDim2.new(1, -10, 0, 28)
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(180, 180, 190)
    TabButton.TextSize = 11

    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Name = tabName .. "Tab"
    ScrollFrame.Parent = ContentArea
    ScrollFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.Size = UDim2.new(1, 0, 1, 0)
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    ScrollFrame.ScrollBarThickness = 4
    ScrollFrame.Visible = false

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Parent = ScrollFrame
    ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Padding = UDim.new(0, 6)

    Tabs[tabName] = ScrollFrame
    TabButtons[tabName] = TabButton

    TabButton.MouseButton1Click:Connect(function()
        for name, frame in pairs(Tabs) do
            frame.Visible = (name == tabName)
            TabButtons[name].BackgroundColor3 = (name == tabName) and Color3.fromRGB(60, 60, 85) or Color3.fromRGB(35, 35, 45)
            TabButtons[name].TextColor3 = (name == tabName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 190)
        end
    end)

    return ScrollFrame
end

local function AddScriptButton(tabFrame, btnName, callback)
    local Btn = Instance.new("TextButton")
    Btn.Parent = tabFrame
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    Btn.BorderSizePixel = 0
    Btn.Size = UDim2.new(1, -10, 0, 36)
    Btn.AutoButtonColor = false
    Btn.Font = Enum.Font.GothamSemibold
    Btn.Text = btnName
    Btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    Btn.TextSize = 12

    Btn.MouseEnter:Connect(function() Btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80) end)
    Btn.MouseLeave:Connect(function() Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 52) end)

    Btn.MouseButton1Click:Connect(function()
        task.spawn(function()
            local success, err = pcall(callback)
            if not success then
                warn("[ScriptHub Error]: " .. btnName .. " -> " .. tostring(err))
            end
        end)
    end)

    local layout = tabFrame:FindFirstChildOfClass("UIListLayout")
    if layout then
        tabFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end
end

