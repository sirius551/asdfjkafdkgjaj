local function UnloadHub()
    for _, conn in ipairs(getgenv().HubActiveConnections) do
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        elseif typeof(conn) == "function" then
            pcall(conn)
        elseif typeof(conn) == "userdata" and conn.Remove then
            pcall(function() conn:Remove() end)
        end
    end
    getgenv().HubActiveConnections = {}
    
    _G.triggerbot = false
    _G.TriggerbotConnected = nil

    if PlayerGui:FindFirstChild("UniversalScriptHub") then
        PlayerGui.UniversalScriptHub:Destroy()
    end
    print("[ScriptHub]: Hub and all active scripts successfully unloaded!")
end

