AddScriptButton(CombatTab, "Triggerbot (Key: E)", function()
    _G.triggerbot = not _G.triggerbot
    local mouse = LocalPlayer:GetMouse()

    if not _G.TriggerbotConnected then
        _G.TriggerbotConnected = true
        RegisterConnection(game:GetService("UserInputService").InputBegan:Connect(function(Input, gpe)
            if not gpe and Input.KeyCode == Enum.KeyCode.E then
                _G.triggerbot = not _G.triggerbot
            end
        end))
        RegisterConnection(game:GetService("RunService").RenderStepped:Connect(function()
            if _G.triggerbot and mouse.Target and mouse.Target.Parent then
                local humanoid = mouse.Target.Parent:FindFirstChildOfClass("Humanoid") or mouse.Target.Parent.Parent:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 and mouse.Target.Parent.Name ~= LocalPlayer.Name then
                    mouse1press()
                    task.wait()
                    mouse1release()
                end
            end
        end))
    end
end)

